{
  "name": "messenger-app",
  "version": "1.5.0",
  "description": "Standalone Facebook Messenger app for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "bash scripts/build.sh"
  },
  "author": "Stefan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.evergreenlabs.MacMessenger",
    "productName": "MessengerApp",
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icon.icns",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  }
}
