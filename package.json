{
  "name": "messenger-app",
  "version": "1.8.4",
  "description": "Standalone Facebook Messenger app for macOS",
  "main": "main.js",
  "repository": "https://github.com/billylo1/messenger-mac-apple-silicon",
  "scripts": {
    "start": "electron .",
    "build": "bash scripts/build.sh"
  },
  "author": "Billy Lo",
  "contributors": [
    "Stefan Minch"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.evergreenlabs.MacMessenger",
    "productName": "MessengerApp",
    "publish": [
      {
        "provider": "github",
        "owner": "billylo1",
        "repo": "messenger-mac-apple-silicon"
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      },
      "extraResources": [
        {
          "from": "Credits.html",
          "to": "Credits.html"
        },
        {
          "from": "aptabase.config.json",
          "to": "aptabase.config.json"
        }
      ]
    }
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "electron-updater": "^6.6.2"
  }
}
